NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Dominio real de producción, sin barra final (https://inmobiliariasenmache.com.ar).
# Se usa para metadataBase, canonical, sitemap.xml, robots.txt y Open Graph.
# Si se omite, usa https://inmobiliariasenmache.com.ar.
NEXT_PUBLIC_SITE_URL=

# Solo para demos/portfolio: en "true" muestra un aviso de "cuenta de prueba"
# en /admin/login (sin credenciales reales). Dejar sin definir en producción.
NEXT_PUBLIC_DEMO_MODE=

# URL real de Instagram del negocio. Sin definir, el ícono de Instagram del
# sitio no se muestra (antes apuntaba a un placeholder — se sacó a propósito).
NEXT_PUBLIC_INSTAGRAM_URL=

# API key de Resend (resend.com) — necesaria para que el formulario de
# contacto del sitio envíe el email de notificación. Sin esto, el formulario
# público muestra error al enviar. Se consigue gratis en resend.com.
RESEND_API_KEY=

# Remitente del email de notificación. Con el dominio de pruebas de Resend
# (onboarding@resend.dev) solo se puede enviar a la casilla con la que te
# registraste en Resend. Para producción real, verificá un dominio propio en
# Resend y poné acá un remitente de ese dominio (ej: "LS Negocios Inmobiliarios <contacto@tu-dominio.com>").
RESEND_FROM_EMAIL=

# Exclusivamente para aplicar migraciones desde una máquina de desarrollo.
# Nunca se usa en runtime — no exponer, no commitear.
SUPABASE_DB_PASSWORD=
